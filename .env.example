# ── Database (Neon) ─────────────────────────────────────────────
# neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Microsoft Azure AD (Employee SSO) ───────────────────────────
# Azure Portal → App registrations → your app
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── Anthropic Claude ─────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── OpenAI (embeddings only) ─────────────────────────────────────
# platform.openai.com → API Keys
OPENAI_API_KEY="sk-..."

# ── Pinecone (vector DB) ─────────────────────────────────────────
# pinecone.io → your project → API Keys
# Create an index named "construction-docs" with dimension 1536
PINECONE_API_KEY=""
PINECONE_INDEX="construction-docs"

# ── Vercel Blob (file storage) ────────────────────────────────────
# Auto-set when you add Blob storage on vercel.com
BLOB_READ_WRITE_TOKEN=""

# ── Access control ───────────────────────────────────────────────
# Only emails ending with this domain can log in
ALLOWED_EMAIL_DOMAIN="yourcompany.com"
